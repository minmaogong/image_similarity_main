   },
   "cell_type": "code",
   "outputs": [],
   "execution_count": 1,
   "source": [
    "import torch\n",
    "from torch.nn import TripletMarginLoss # 三元组损失函数（对比损失）"
   ],
   "id": "4fef0655183961c5"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-08-13T07:31:00.266846Z",
     "start_time": "2026-08-13T07:31:00.184050Z"
    }
   },
   "cell_type": "code",
   "source": "loss_fn = TripletMarginLoss(margin=1.0, p=2)",
   "id": "bfda10908ffd7d60",
   "outputs": [],
   "execution_count": 2
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-08-13T07:31:34.742410Z",
     "start_time": "2026-08-13T07:31:34.635662Z"
    }
   },
   "cell_type": "code",
   "source": [
    "a = torch.randn(100, 5)\n",
    "p = torch.randn(100, 5)\n",
    "n = torch.randn(100, 5)"
   ],
   "id": "791106e7b4b2bb70",
   "outputs": [],
   "execution_count": 3
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-08-13T07:31:46.507396Z",
     "start_time": "2026-08-13T07:31:46.400183Z"
    }
   },
   "cell_type": "code",
   "source": [
    "loss = loss_fn(a, p, n)\n",
    "print(loss)"
   ],
   "id": "d4572ed5c25d0fb5",
